{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hangangbus-secure-portal",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SESSION_HOURS": "8",
    "PBKDF2_ITERATIONS": "210000"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hangangbus-auth",
      "database_id": "d26ba20a-e94e-4b2e-bd7b-1b12e86aa7c9"
    }
  ]
}